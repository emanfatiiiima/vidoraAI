# ---------------------------------------------------------------------------
# VidoraAI configuration. Copy this file to `.env` and fill in your keys.
# The backend reads it on startup (see core/config.py). All keys are optional:
# features degrade gracefully when a key is missing.
# ---------------------------------------------------------------------------

# --- Text generation (tried in LLM_PROVIDER_ORDER, missing keys are skipped) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER_ORDER=gemini,openai,groq

# --- Research: Google Trends via SerpApi (Step 2 "Live Trends") ---
SERPAPI_KEY=

# --- Text-to-speech: UnrealSpeech (Step 4 "Audio") ---
UNREAL_SPEECH_API_KEY=

# --- Image generation: Leonardo.ai (Step 5 "Images", when picked in the UI) ---
LEONARDO_API_KEY=

# --- Optional model overrides ---
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# LEONARDO_MODEL_ID=de7d3faf-762f-48e0-b3b7-9d0ac3a3fcf3

# --- Local AI (see LOCAL_SETUP.md) ---
# true = hide every cloud AI in the "Choose your AIs" popup.
LOCAL_ONLY=false
OLLAMA_URL=http://127.0.0.1:11434
# Model for automatic (not user-picked) text generation, e.g. qwen3:8b
OLLAMA_DEFAULT_MODEL=
OLLAMA_NUM_CTX=8192
# GPU worker started with: local_ai\.venv\Scripts\python -m local_ai
LOCAL_AI_URL=http://127.0.0.1:8001
LOCAL_AI_TIMEOUT_SECONDS=3600
# FFmpeg on PATH (or a full path to ffmpeg.exe); Kdenlive's melt is auto-detected.
FFMPEG_PATH=ffmpeg
# MELT_PATH=C:\Program Files\kdenlive\bin\melt.exe
# Final video size (9:16 vertical). Use 1920x1080 for landscape YouTube videos.
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# --- Optional server settings ---
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HTTP_TIMEOUT_SECONDS=60
